# ========================================================
# Nutrishift Portal Environment Configuration Template
# Copy to .env.local and fill in values for local development.
# ========================================================

# Auth.js secret (Generate with: npx auth secret)
AUTH_SECRET=

# Public Base URL for Portal
NEXTAUTH_URL=http://localhost:3000

# ERPNext / Frappe HMS Backend
ERPNEXT_URL=https://erp.nutri-shift.com
ERPNEXT_ADMIN_API_KEY=
ERPNEXT_ADMIN_API_SECRET=
ERPNEXT_WEBHOOK_SECRET=

# Ghost CMS (Blog / Educational Hub)
GHOST_URL=https://blog.nutri-shift.com
GHOST_ADMIN_API_KEY=
GHOST_CONTENT_API_KEY=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment Integrations (Optional)
PAYMENT_WEBHOOK_SECRET=
